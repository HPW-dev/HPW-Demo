#version 330 core

out vec2 uv;

// теперь это полноэкранный треугольник, в который рендерится текстура
void main() {
// (c) Gemini
  // 1. Генерируем текстурные координаты напрямую (от 0.0 до 2.0)
  uv = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
    
  // 2. Инвертируем позицию по Y, чтобы перевернуть экран обратно "на ноги"
  //    и сдвигаем по X, чтобы убрать горизонтальное отражение
  gl_Position = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 0.0, 1.0);
}
