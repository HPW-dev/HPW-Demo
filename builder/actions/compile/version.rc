#pragma code_page(65001) // Переключает windres в режим UTF-8

#include <windows.h>

IDI_ICON1 ICON "builder/actions/compile/hpw-icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 041904b0: 0419 = Русский язык, 04b0 = Юникод (Codepage 1200)
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName",      "HPW-Dev"
            VALUE "FileDescription",  "Игра H.P.W"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "H.P.W"
            VALUE "LegalCopyright",   "© 2020-2026 HPW-Dev"
            VALUE "OriginalFilename", "HPW.exe"
            VALUE "ProductName",      "H.P.W"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END
